PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Keep this secret on the server. Never put it in public frontend code.
NVIDIA_API_KEY=replace-with-your-nvidia-api-key

# Change the model through hosting settings without editing source code.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Required in production. Visitors enter this password before generating replies.
APP_PASSWORD=replace-with-a-long-random-password

# Simple per-IP protection for this MVP.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=3600000
